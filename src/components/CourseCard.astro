---
const { number, title, subtitle, description, tag } = Astro.props;
---
<article class="course-card">
  <div class="course-top"><span>{number}</span><span class="course-tag">{tag}</span></div>
  <div>
    <p class="course-subtitle">{subtitle}</p>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <a href="#interesse" class="text-link">Interesse anmelden <span aria-hidden="true">↗</span></a>
</article>
