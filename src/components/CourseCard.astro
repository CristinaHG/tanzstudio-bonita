
---
const { title, description } = Astro.props;
const interestUrl = `#interesse?kurs=${encodeURIComponent(title)}`;
---

<article class="course-card">
  <div class="course-top"></div>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <a href={interestUrl} class="text-link">
    Interesse anmelden <span aria-hidden="true">↗</span>
  </a>
</article>
