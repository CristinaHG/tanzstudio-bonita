
---
const { title, description } = Astro.props;
const interestUrl = `#interesse?kurs=${encodeURIComponent(title)}`;
---

<article class="course-card">
  <div class="course-top"></div>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
 <a
   href={`?kurs=${encodeURIComponent(title)}#interesse`}
   class="text-link"
 >
   Interesse anmelden <span aria-hidden="true">↗</span>
 </a>
</article>
<style>
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  margin-top: 20px;
  padding: 12px 16px;
  border: 0;
  background: var(--terracotta);
  color: white;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .3px;
  text-decoration: none;
  cursor: pointer;
  border-radius: 2px;
  transition: background .2s ease, transform .2s ease;
}

.text-link:hover {
  background: #9e5c48;
  transform: translateY(-2px);
}
</style>
