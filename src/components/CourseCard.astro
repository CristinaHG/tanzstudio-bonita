
---
const { title, description, status } = Astro.props;
const isPlanned = status === "In Planung";---

<article class:list={["course-card", { planned: isPlanned }]}>
  <div class="course-top"></div>

  <div class="course-heading">
    <h3>{title}</h3>
    {status && <span class="course-status">{status}</span>}
  </div>

  <p>{description}</p>

  <a
    href={`?kurs=${encodeURIComponent(title)}#interesse`}
    class="text-link"
  >
    Interesse anmelden <span aria-hidden="true">↗</span>
  </a>
</article>
<style>
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 18px;
  margin-top: 20px;
  padding: 12px 16px;
  border: 0;
  background: var(--terracotta);
  color: white;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .3px;
  text-decoration: none;
  cursor: pointer;
  border-radius: 2px;
  transition: background .2s ease, transform .2s ease;
}

.text-link:hover {
  background: #9e5c48;
  transform: translateY(-2px);
}
.course-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px 14px;
  margin-bottom: 16px;
}

.course-heading h3 {
  margin: 0;
}

.course-status {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 2px;
  background: #f1e3dc;
  color: var(--terracotta);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .5px;
  white-space: nowrap;
}

.course-card.planned {
  opacity: 0.75;
}
</style>
